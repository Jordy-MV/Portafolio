            os.system('start "" "C:\\Program Files\\Docker\\Docker\\Docker Desktop.exe"')
            time.sleep(2.5)
            os.system("taskkill /IM Microsoft.Media.Player.exe /F")

        else:
            # Agregar el input del usuario al historial
            conversation_history.append(f"Tú: {user_input}")

            # Limitar el tamaño del historial para evitar exceder la capacidad del modelo
            MAX_HISTORIAL = 20  # Puedes ajustar este número según sea necesario
            if len(conversation_history) > MAX_HISTORIAL * 2:
                conversation_history = conversation_history[-MAX_HISTORIAL * 2:]

            # Crear el prompt uniendo el historial
            prompt = '\n'.join(conversation_history) + '\nTes:'

            try:
                # Generar respuesta utilizando el historial como contexto
                # Habilitar el streaming de la respuesta
                print("Tes: ", end='', flush=True)
                respuesta_texto = ''
                for response in ollama.generate(model='llama3.2:1b', prompt=prompt, stream=True):
                    chunk = response['response']
                    print(chunk, end='', flush=True)
                    respuesta_texto += chunk

                print()  # Imprimir una nueva línea al final de la respuesta

                # Agregar la respuesta del modelo al historial
                conversation_history.append(f"Tes: {respuesta_texto.strip()}")

                # Guardar el historial en el archivo
                guardar_historial(conversation_history)

            except Exception as e:
                print("\nOcurrió un error al generar la respuesta:", e)
                continue

    # Guardar el historial al salir del programa
    guardar_historial(conversation_history)

