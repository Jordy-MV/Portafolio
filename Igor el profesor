import ollama
import webbrowser
import os
import time
import os.path

# Ruta del archivo donde se guardará el historial de conversación
HISTORIAL_FILENAME = "historial_conversacion.txt"

 # Función para cargar el historial desde el archivo
def cargar_historial():
    if os.path.exists(HISTORIAL_FILENAME):
      with open(HISTORIAL_FILENAME, 'r', encoding='utf-8') as file:
             historial = file.read().splitlines()
      return historial
    else:
      return []

# Función para guardar el historial en el archivo
def guardar_historial(historial):
     with open(HISTORIAL_FILENAME, 'w', encoding='utf-8') as file:
         for linea in historial:
            file.write(linea + '\n')

# Presentación inicial
os.system("start Presentacion.mp3")
time.sleep(2.5)
os.system("taskkill /IM Microsoft.Media.Player.exe /F")

def chat_with_ollama():
    print("//Hola Jordy soy Tes!//")
    
    # Cargar el historial existente
    conversation_history = cargar_historial()

