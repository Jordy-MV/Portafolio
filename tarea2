#include <iostream>
#include <string>

using namespace std;

const int MAX = 5;

struct Tarea {
    int codigo;
    string nombre;
    string fecha;
    string horaInicio;
    string horaFin;
    bool activa;
};

Tarea tareas[MAX];
int cantidad = 0;

bool formatoFecha(string f) {
    return f.length() == 10 && f[2] == '/' && f[5] == '/';
}

bool formatoHora(string h) {
    return h.length() == 5 && h[2] == ':';
}

void agregar() {
    if (cantidad >= MAX) {
        cout << "No se pueden agregar mas tareas\n";
        return;
    }

    int n;
    cout << "Cuantas tareas desea agregar (1-5): ";
    cin >> n;
    if (n < 1 || n > 5 || cantidad + n > 5) {
        cout << "Cantidad fuera de rango\n";
        return;
    }

    cin.ignore();
    for (int i = 0; i < n; i++) {
        Tarea t;
        string temp;

        cout << "Codigo (4 digitos): ";
        getline(cin, temp);
        if (temp.length() != 4) {
            cout << "Codigo invalido\n";
            i--;
            continue;
        }
        t.codigo = stoi(temp);

        cout << "Nombre: ";
        getline(cin, t.nombre);
        if (t.nombre.empty()) {
            cout << "Nombre vacio\n";
            i--;
            continue;
        }

        cout << "Fecha (dd/mm/aaaa): ";
        getline(cin, t.fecha);
        if (!formatoFecha(t.fecha)) {
            cout << "Formato incorrecto\n";
            i--;
            continue;
        }

        cout << "Hora inicio (hh:mm): ";
        getline(cin, t.horaInicio);
        if (!formatoHora(t.horaInicio)) {
            cout << "Formato incorrecto\n";
            i--;
            continue;
        }

        cout << "Hora fin (hh:mm): ";
        getline(cin, t.horaFin);
        if (!formatoHora(t.horaFin)) {
            cout << "Formato incorrecto\n";
            i--;
            continue;
        }

        t.activa = true;
        tareas[cantidad++] = t;
        cout << "Tarea agregada\n";
    }
}

void mostrar() {
    if (cantidad == 0) {
        cout << "No hay tareas\n";
        return;
    }
    for (int i = 0; i < cantidad; i++) {
        if (tareas[i].activa) {
            cout << "Codigo: " << tareas[i].codigo << endl;
            cout << "Nombre: " << tareas[i].nombre << endl;
            cout << "Fecha: " << tareas[i].fecha << endl;
            cout << "Hora inicio: " << tareas[i].horaInicio << endl;
            cout << "Hora fin: " << tareas[i].horaFin << endl;
            cout << "----------------------\n";
        }
    }
}

void buscar() {
    if (cantidad == 0) {
        cout << "Debe ingresar primero la tarea\n";
        return;
    }
    int cod;
    cout << "Codigo a buscar: ";
    cin >> cod;
    for (int i = 0; i < cantidad; i++) {
        if (tareas[i].activa && tareas[i].codigo == cod) {
            cout << "Nombre: " << tareas[i].nombre << endl;
            cout << "Fecha: " << tareas[i].fecha << endl;
            cout << "Hora inicio: " << tareas[i].horaInicio << endl;
            cout << "Hora fin: " << tareas[i].horaFin << endl;
            return;
        }
    }
    cout << "Tarea no encontrada\n";
}

void eliminar() {
    if (cantidad == 0) {
        cout << "Debe ingresar primero la tarea\n";
        return;
    }
    int cod;
    cout << "Codigo a eliminar: ";
    cin >> cod;
    for (int i = 0; i < cantidad; i++) {
        if (tareas[i].activa && tareas[i].codigo == cod) {
            tareas[i].activa = false;
            cout << "Tarea eliminada\n";
            return;
        }
    }
    cout << "Tarea no encontrada\n";
}

int main() {
    int op;
    do {
        cout << "\nMENU\n";
        cout << "1. Agregar\n";
        cout << "2. Buscar\n";
        cout << "3. Mostrar\n";
        cout << "4. Eliminar\n";
        cout << "5. Salir\n";
        cout << "Opcion: ";
        cin >> op;

        switch(op) {
            case 1: agregar(); break;
            case 2: buscar(); break;
            case 3: mostrar(); break;
            case 4: eliminar(); break;
            case 5: cout << "Saliendo...\n"; break;
            default: cout << "Opcion invalida\n";
        }
    } while (op != 5);

    return 0;
}

